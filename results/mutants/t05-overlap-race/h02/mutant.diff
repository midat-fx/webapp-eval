@@ -0,0 +1,12 @@
+-- Holds only stop two clients checking out the *same* start time. Two
+-- different starts can still overlap (14:00 for 60 min, 14:15 for 45 min),
+-- and two app servers can race past each other's checks. The database is the
+-- one place that sees every insert, so it gets the final word.
+CREATE EXTENSION IF NOT EXISTS btree_gist;
+--> statement-breakpoint
+ALTER TABLE "bookings" ADD CONSTRAINT "bookings_no_overlap"
+  EXCLUDE USING gist (
+    "staff_id" WITH =,
+    tstzrange("start_at", "end_at") WITH &&
+  )
+  WHERE ("status" = 'confirmed');
