+/**
+ * The client turns an offer down. The slot goes to the next person in line
+ * right away instead of sitting on hold until the offer would have expired.
+ * Returns false when there was nothing to decline (claimed, expired, unknown).
+ */
+export async function declineOffer(token: string): Promise<boolean> {
+  return db.transaction(async (tx) => {
+    // The status check is part of the UPDATE, so a double tap or a second tab
+    // waits for the first decline and then finds nothing left to decline.
+    const [entry] = await tx
+      .update(s.waitlistEntries)
+      .set({ status: "declined", offerToken: null, offerHoldToken: null, offerExpiresAt: null })
+      .where(and(eq(s.waitlistEntries.offerToken, token), eq(s.waitlistEntries.status, "offered")))
+      .returning();
+    if (!entry) return false;
+
+    const slot = {
+      staffId: entry.offerStaffId!,
+      serviceId: entry.serviceId,
+      startMs: entry.offerSlotStartAt!.getTime(),
+      endMs: entry.offerSlotEndAt!.getTime(),
+    };
+    await tx.insert(s.auditLog).values({
+      businessId: entry.businessId,
+      action: "waitlist.declined",
+      entity: "waitlist_entry",
+      entityId: entry.id,
+      meta: { staffId: slot.staffId, startMs: slot.startMs },
+    });
+    await cancelByDedupeKey(tx, `waitlist.expire:${entry.id}:${slot.startMs}`);
+    await enqueue(tx, {
+      businessId: entry.businessId,
+      topic: "waitlist.slot_freed",
+      payload: slot,
+      dedupeKey: `waitlist.declined:${entry.id}:${slot.startMs}`,
+    });
+    // Before the commit: once the message is visible a worker may offer the
+    // slot to the next client, and that offer needs the hold to be gone.
+    await releaseHold(slot.staffId, slot.startMs);
+    return true;
+  });
+}
+
 async function releaseHold(staffId: string, startMs: number): Promise<void> {
   await redis().del(`hold:${staffId}:${startMs}`);
 }
