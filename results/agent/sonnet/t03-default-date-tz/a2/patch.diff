+/** Local calendar date `YYYY-MM-DD` in `timeZone` at the given instant. */
+export function todayInTimeZone(timeZone: string, nowMs: number = Date.now()): string {
+  const parts: Record<string, string> = {};
+  const dtf = new Intl.DateTimeFormat("en-US", {
+    timeZone,
+    year: "numeric",
+    month: "2-digit",
+    day: "2-digit",
+  });
+  for (const { type, value } of dtf.formatToParts(nowMs)) parts[type] = value;
+  return `${parts.year.padStart(4, "0")}-${parts.month}-${parts.day}`;
+}
