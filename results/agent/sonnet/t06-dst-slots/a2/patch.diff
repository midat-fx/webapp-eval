+
+describe("localTimeToUtc on clock-change days", () => {
+  it("Berlin spring forward and fall back", () => {
+    expect(localTimeToUtc("2027-03-28", "10:00", "Europe/Berlin")).toBe(Date.UTC(2027, 2, 28, 8, 0));
+    expect(localTimeToUtc("2027-03-28", "00:00", "Europe/Berlin")).toBe(Date.UTC(2027, 2, 27, 23, 0));
+    expect(localTimeToUtc("2027-10-31", "10:00", "Europe/Berlin")).toBe(Date.UTC(2027, 9, 31, 9, 0));
+    expect(localTimeToUtc("2027-10-31", "00:00", "Europe/Berlin")).toBe(Date.UTC(2027, 9, 30, 22, 0));
+  });
+  it("New York clock changes", () => {
+    expect(localTimeToUtc("2027-03-14", "10:00", "America/New_York")).toBe(Date.UTC(2027, 2, 14, 14, 0));
+    expect(localTimeToUtc("2027-11-07", "10:00", "America/New_York")).toBe(Date.UTC(2027, 10, 7, 15, 0));
+  });
+  it("slots follow opening hours", () => {
+    const s = slotsForDay({ dateISO: "2027-03-28", timeZone: "Europe/Berlin", window: { open: "10:00", close: "20:00" }, durationMin: 60 });
+    expect(s[0].startMs).toBe(Date.UTC(2027, 2, 28, 8, 0));
+    expect(s.at(-1)!.endMs).toBe(Date.UTC(2027, 2, 28, 18, 0));
+  });
+});
