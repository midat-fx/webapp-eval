+  it("Berlin spring-forward day opens at 10:00 local and closes at 20:00", () => {
+    expect(new Date(localTimeToUtc("2027-03-28", "10:00", "Europe/Berlin")).toISOString()).toBe("2027-03-28T08:00:00.000Z");
+    const slots = slotsForDay({
+      dateISO: "2027-03-28",
+      timeZone: "Europe/Berlin",
+      window: { open: "10:00", close: "20:00" },
+      durationMin: 60,
+    });
+    expect(new Date(slots[0].startMs).toISOString()).toBe("2027-03-28T08:00:00.000Z");
+    expect(new Date(slots.at(-1)!.endMs).toISOString()).toBe("2027-03-28T18:00:00.000Z");
+  });
+  it("Berlin fall-back day opens at 10:00 local", () => {
