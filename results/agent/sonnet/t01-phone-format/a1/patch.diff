diff --git a/src/lib/phone.test.ts b/src/lib/phone.test.ts
new file mode 100644
index 0000000..9771d20
--- /dev/null
+++ b/src/lib/phone.test.ts
@@ -0,0 +1,16 @@
+import { describe, expect, it } from "vitest";
+import { isValidPhone, normalizePhone } from "./phone";
+
+describe("phone", () => {
+  it.each(["+7 701 555 12 34", "+7 (701) 555-12-34", "+7-701-555-12-34", "+7.701.555.12.34", " +77015551234 "])(
+    "normalizes %s",
+    (raw) => {
+      const n = normalizePhone(raw);
+      expect(n).toBe("+77015551234");
+      expect(isValidPhone(n)).toBe(true);
+    },
+  );
+  it.each(["call me", "+7 701", "", "+7+701 555 12 34"])("rejects %s", (raw) => {
+    expect(isValidPhone(normalizePhone(raw))).toBe(false);
+  });
+});
diff --git a/src/lib/phone.ts b/src/lib/phone.ts
new file mode 100644
index 0000000..6af2a8d
--- /dev/null
+++ b/src/lib/phone.ts
@@ -0,0 +1,9 @@
+const PHONE_RE = /^\+?\d{10,15}$/;
+
+export function normalizePhone(input: string): string {
+  return input.replace(/[\s\-.()]/g, "");
+}
+
+export function isValidPhone(normalized: string): boolean {
+  return PHONE_RE.test(normalized);
+}
