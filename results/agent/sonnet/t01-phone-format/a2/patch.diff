diff --git a/src/lib/phone.test.ts b/src/lib/phone.test.ts
new file mode 100644
index 0000000..ca157ec
--- /dev/null
+++ b/src/lib/phone.test.ts
@@ -0,0 +1,15 @@
+import { describe, expect, it } from "vitest";
+import { normalizePhone, phoneSchema } from "./phone";
+
+describe("phone", () => {
+  it.each(["+7 701 555 12 34", "+7 (701) 555-12-34", "+7-701-555-12-34", "+7.701.555.12.34", " +77015551234 "])(
+    "accepts %s",
+    (p) => {
+      expect(phoneSchema.parse(p)).toBe("+77015551234");
+      expect(normalizePhone(p)).toBe("+77015551234");
+    },
+  );
+  it.each(["call me", "+7 701", "", "+7 (701) 555-12-3x"])("rejects %s", (p) => {
+    expect(phoneSchema.safeParse(p).success).toBe(false);
+  });
+});
diff --git a/src/lib/phone.ts b/src/lib/phone.ts
new file mode 100644
index 0000000..28f9f20
--- /dev/null
+++ b/src/lib/phone.ts
@@ -0,0 +1,12 @@
+import { z } from "zod";
+
+const SEPARATORS = /[\s\-.() ]/g;
+
+export function normalizePhone(input: string): string {
+  return input.trim().replace(SEPARATORS, "");
+}
+
+export const phoneSchema = z
+  .string()
+  .transform(normalizePhone)
+  .pipe(z.string().regex(/^\+?\d{10,15}$/));
