diff --git a/src/lib/phone.test.ts b/src/lib/phone.test.ts
new file mode 100644
index 0000000..4dca314
--- /dev/null
+++ b/src/lib/phone.test.ts
@@ -0,0 +1,22 @@
+import { describe, expect, it } from "vitest";
+import { phone } from "./phone";
+
+describe("phone", () => {
+  it.each([
+    ["+77015551234", "+77015551234"],
+    ["+7 701 555 12 34", "+77015551234"],
+    ["+7 (701) 555-12-34", "+77015551234"],
+    ["+7-701-555-12-34", "+77015551234"],
+    ["+7.701.555.12.34", "+77015551234"],
+    ["  +7 701 555 12 34  ", "+77015551234"],
+  ])("normalizes %j to %j", (input, expected) => {
+    expect(phone.parse(input)).toBe(expected);
+  });
+
+  it.each(["call me", "+7 701", "+7 701 555 12 3x", "", "+7 (701) 555-12-34-56-78-90"])(
+    "rejects %j",
+    (input) => {
+      expect(phone.safeParse(input).success).toBe(false);
+    },
+  );
+});
diff --git a/src/lib/phone.ts b/src/lib/phone.ts
new file mode 100644
index 0000000..d5d1a84
--- /dev/null
+++ b/src/lib/phone.ts
@@ -0,0 +1,8 @@
+import { z } from "zod";
+
+const FORMATTING = /[\s\-().]/g;
+
+export const phone = z
+  .string()
+  .transform((raw) => raw.replace(FORMATTING, ""))
+  .pipe(z.string().regex(/^\+?\d{10,15}$/));
