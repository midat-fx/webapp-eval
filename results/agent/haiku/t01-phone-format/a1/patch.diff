diff --git a/src/lib/phone.test.ts b/src/lib/phone.test.ts
new file mode 100644
index 0000000..d81c8fd
--- /dev/null
+++ b/src/lib/phone.test.ts
@@ -0,0 +1,24 @@
+import { describe, expect, it } from "vitest";
+import { phoneSchema } from "./phone";
+
+const parse = (v: string) => phoneSchema.safeParse(v);
+
+describe("phoneSchema", () => {
+  it.each([
+    ["+7 701 555 12 34", "+77015551234"],
+    ["+7 (701) 555-12-34", "+77015551234"],
+    ["+7-701-555-12-34", "+77015551234"],
+    ["+7.701.555.12.34", "+77015551234"],
+    ["  +77015551234  ", "+77015551234"],
+    ["77015551234", "+77015551234"],
+  ])("normalizes %j to %s", (input, expected) => {
+    expect(parse(input)).toEqual({ success: true, data: expected });
+  });
+
+  it.each(["call me", "+7 701", "+7 701 555 12 3a", "++77015551234", "+7701555123456789", ""])(
+    "rejects %j",
+    (input) => {
+      expect(parse(input).success).toBe(false);
+    },
+  );
+});
diff --git a/src/lib/phone.ts b/src/lib/phone.ts
new file mode 100644
index 0000000..f4a329c
--- /dev/null
+++ b/src/lib/phone.ts
@@ -0,0 +1,9 @@
+import { z } from "zod";
+
+const FORMATTING = /[\s().\-‐‑‒–—]/g;
+
+export const phoneSchema = z
+  .string()
+  .transform((raw) => raw.replace(FORMATTING, ""))
+  .pipe(z.string().regex(/^\+?\d{10,15}$/))
+  .transform((digits) => (digits.startsWith("+") ? digits : `+${digits}`));
