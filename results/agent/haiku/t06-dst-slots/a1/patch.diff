+describe("localTimeToUtc across DST transitions", () => {
+  it("Berlin summer-time start day: 10:00 is CEST (UTC+2)", () => {
+    expect(localTimeToUtc("2027-03-28", "10:00", "Europe/Berlin")).toBe(Date.UTC(2027, 2, 28, 8, 0));
+    expect(localTimeToUtc("2027-03-28", "20:00", "Europe/Berlin")).toBe(Date.UTC(2027, 2, 28, 18, 0));
+  });
+  it("Berlin winter-time start day: 10:00 is CET (UTC+1)", () => {
+    expect(localTimeToUtc("2027-10-31", "10:00", "Europe/Berlin")).toBe(Date.UTC(2027, 9, 31, 9, 0));
+    expect(localTimeToUtc("2027-10-31", "20:00", "Europe/Berlin")).toBe(Date.UTC(2027, 9, 31, 19, 0));
+  });
+  it("New York clock-change days", () => {
+    expect(localTimeToUtc("2027-03-14", "10:00", "America/New_York")).toBe(Date.UTC(2027, 2, 14, 14, 0));
+    expect(localTimeToUtc("2027-11-07", "10:00", "America/New_York")).toBe(Date.UTC(2027, 10, 7, 15, 0));
+  });
+});
+
+describe("slotsForDay on a DST transition day", () => {
+  it("Berlin Sunday 28 Mar 2027 opens at 10:00 local and closes at 20:00 local", () => {
+    const slots = slotsForDay({
+      dateISO: "2027-03-28",
+      timeZone: "Europe/Berlin",
+      window: { open: "10:00", close: "20:00" },
+      durationMin: 60,
+      stepMin: 60,
+    });
+    expect(slots[0].startMs).toBe(Date.UTC(2027, 2, 28, 8, 0));
+    expect(slots[slots.length - 1].endMs).toBe(Date.UTC(2027, 2, 28, 18, 0));
+    expect(slots).toHaveLength(10);
+  });
+  it("Berlin Sunday 31 Oct 2027 does not offer 09:00", () => {
+    const slots = slotsForDay({
+      dateISO: "2027-10-31",
+      timeZone: "Europe/Berlin",
+      window: { open: "10:00", close: "20:00" },
+      durationMin: 60,
+      stepMin: 60,
+    });
+    expect(slots[0].startMs).toBe(Date.UTC(2027, 9, 31, 9, 0));
+    expect(slots[slots.length - 1].endMs).toBe(Date.UTC(2027, 9, 31, 19, 0));
+    expect(slots).toHaveLength(10);
+  });
+});
