+describe("localTimeToUtc on DST-change days", () => {
+  it("Berlin spring-forward: 10:00 local is 08:00 UTC once CEST has started", () => {
+    expect(localTimeToUtc("2027-03-28", "10:00", "Europe/Berlin")).toBe(Date.UTC(2027, 2, 28, 8));
+  });
+  it("Berlin fall-back: 10:00 local is 09:00 UTC once CET has started", () => {
+    expect(localTimeToUtc("2027-10-31", "10:00", "Europe/Berlin")).toBe(Date.UTC(2027, 9, 31, 9));
+  });
+  it("New York spring-forward: 09:00 local is 13:00 UTC", () => {
+    expect(localTimeToUtc("2027-03-14", "09:00", "America/New_York")).toBe(
+      Date.UTC(2027, 2, 14, 13),
+    );
+  });
+});
+
+describe("slotsForDay on DST-change days", () => {
+  const berlinSunday = {
+    timeZone: "Europe/Berlin",
+    window: { open: "10:00", close: "20:00" },
+    durationMin: 60,
+    stepMin: 60,
+  };
+  const expectOpenToClose = (dateISO: string) => {
+    const slots = slotsForDay({ ...berlinSunday, dateISO });
+    expect(slots[0].startMs).toBe(localTimeToUtc(dateISO, "10:00", "Europe/Berlin"));
+    expect(slots[slots.length - 1].endMs).toBe(localTimeToUtc(dateISO, "20:00", "Europe/Berlin"));
+    expect(slots).toHaveLength(10);
+  };
+  it("spring-forward: first slot at opening, last slot ends at closing", () => {
+    expectOpenToClose("2027-03-28");
+  });
+  it("fall-back: first slot at opening, last slot ends at closing", () => {
+    expectOpenToClose("2027-10-31");
+  });
+});
+
