+  it("uses the offset in effect at the wall time on a DST-start day", () => {
+    // Berlin switches to CEST at 01:00 UTC on 2027-03-28
+    expect(localTimeToUtc("2027-03-28", "10:00", "Europe/Berlin")).toBe(Date.UTC(2027, 2, 28, 8, 0));
+    expect(localTimeToUtc("2027-03-28", "00:30", "Europe/Berlin")).toBe(
+      Date.UTC(2027, 2, 27, 23, 30),
+    );
+  });
+  it("uses the offset in effect at the wall time on a DST-end day", () => {
+    // Berlin switches back to CET at 01:00 UTC on 2027-10-31
+    expect(localTimeToUtc("2027-10-31", "10:00", "Europe/Berlin")).toBe(Date.UTC(2027, 9, 31, 9, 0));
+    expect(localTimeToUtc("2027-10-31", "00:30", "Europe/Berlin")).toBe(
+      Date.UTC(2027, 9, 30, 22, 30),
+    );
+  });
+  it("New York DST days keep local opening time", () => {
+    expect(localTimeToUtc("2027-03-14", "10:00", "America/New_York")).toBe(Date.UTC(2027, 2, 14, 14, 0));
+    expect(localTimeToUtc("2027-11-07", "10:00", "America/New_York")).toBe(Date.UTC(2027, 10, 7, 15, 0));
+  });
+});
+
+describe("slotsForDay across clock changes", () => {
+  const sunday = (dateISO: string, timeZone: string) =>
+    slotsForDay({
+      dateISO,
+      timeZone,
+      window: { open: "10:00", close: "20:00" },
+      durationMin: 60,
+      stepMin: 60,
+    });
+
+  it("Berlin summer-time start: 10:00 first, 20:00 last end", () => {
+    const slots = sunday("2027-03-28", "Europe/Berlin");
+    expect(slots).toHaveLength(10);
+    expect(slots[0].startMs).toBe(Date.UTC(2027, 2, 28, 8, 0));
+    expect(slots[9].endMs).toBe(Date.UTC(2027, 2, 28, 18, 0));
+  });
+  it("Berlin winter-time start: 10:00 first, 20:00 last end", () => {
+    const slots = sunday("2027-10-31", "Europe/Berlin");
+    expect(slots).toHaveLength(10);
+    expect(slots[0].startMs).toBe(Date.UTC(2027, 9, 31, 9, 0));
+    expect(slots[9].endMs).toBe(Date.UTC(2027, 9, 31, 19, 0));
+  });
+  it("New York DST days: 10:00 first, 20:00 last end", () => {
+    const march = sunday("2027-03-14", "America/New_York");
+    expect(march[0].startMs).toBe(Date.UTC(2027, 2, 14, 14, 0));
+    expect(march[9].endMs).toBe(Date.UTC(2027, 2, 15, 0, 0));
+    const november = sunday("2027-11-07", "America/New_York");
+    expect(november[0].startMs).toBe(Date.UTC(2027, 10, 7, 15, 0));
+    expect(november[9].endMs).toBe(Date.UTC(2027, 10, 8, 1, 0));
+  });
 });
 
