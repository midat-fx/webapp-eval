+    expect(client.phone).toBe("+77013333333");
+  });
+
+  it("returns the slot to public stock when nobody else is waiting", async () => {
+    const booked = await book();
+    await join("+77012222222");
+    await cancel((booked as { bookingId: string }).bookingId);
+    await drainOnce();
+
+    const only = (await entries()).find((r) => r.status === "offered")!;
+    await declineOffer(only.offerToken!);
+
+    const free = await getAvailability({
+      businessId: f.business.id,
+      timeZone: f.business.timezone,
+      staffId: f.master.id,
+      serviceId: f.service.id,
+      dateISO: date,
+    });
+    expect(free.map((sl) => sl.startMs)).toContain(slotAt().startMs);
+  });
+
+  it("is idempotent: a double tap offers the slot onward once", async () => {
+    const first = await offerToFirstOfTwo();
+    expect(await declineOffer(first.offerToken!)).toEqual({ ok: true });
+    expect(await declineOffer(first.offerToken!)).toEqual({ ok: true });
+    await drainOnce();
+    await drainOnce();
+
+    expect(await offers()).toHaveLength(2); // one for the first client, one for the second
+    expect((await entries()).filter((r) => r.status === "offered")).toHaveLength(1);
+  });
+
+  it("settles a simultaneous claim and decline exactly once", async () => {
+    const first = await offerToFirstOfTwo();
+    const [claim, decline] = await Promise.all([
+      acceptOffer(first.offerToken!),
+      declineOffer(first.offerToken!),
+    ]);
+    await drainOnce();
+    await drainOnce();
+
+    const bookings = await db.select().from(s.bookings).where(eq(s.bookings.status, "confirmed"));
+    const offered = (await entries()).filter((r) => r.status === "offered");
+    if (claim.ok) {
+      expect(decline).toEqual({ ok: false, error: "expired" });
+      expect(bookings).toHaveLength(1);
+      expect(offered).toHaveLength(0);
+    } else {
+      expect(decline).toEqual({ ok: true });
+      expect(bookings).toHaveLength(0);
+      expect(offered).toHaveLength(1);
+    }
+  });
+
+  it("kills the link: it can no longer be claimed", async () => {
+    const first = await offerToFirstOfTwo();
+    await declineOffer(first.offerToken!);
