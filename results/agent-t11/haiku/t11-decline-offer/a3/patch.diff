+  });
+
+  it("does nothing to a booking that was already claimed", async () => {
+    const first = await offerToFirstOfTwo();
+    expect((await acceptOffer(first.offerToken!)).ok).toBe(true);
+
+    expect(await declineOffer(first.offerToken!)).toEqual({ ok: false, error: "expired" });
+    await drainOnce();
+
+    expect((await entries()).find((r) => r.id === first.id)!.status).toBe("booked");
+    expect(await db.select().from(s.bookings).where(eq(s.bookings.status, "confirmed")))
+      .toHaveLength(1);
+    expect((await entries()).filter((r) => r.status === "offered")).toHaveLength(0);
+    expect(await offers()).toHaveLength(1);
+  });
+});
