+      .where(and(eq(s.waitlistEntries.offerToken, token), eq(s.waitlistEntries.status, "offered")))
+      .returning();
+    if (!entry) return;
+
+    await releaseOfferHold(entry);
+    await queueNextOffer(tx, entry);
