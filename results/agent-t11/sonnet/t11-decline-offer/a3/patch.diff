+
+export type DeclineResult = { ok: true } | { ok: false; error: "not_found" | "not_offered" };
+
+/**
+ * The client turns the offer down. The first call wins; repeats, other tabs and
+ * calls on an offer that was already claimed are no-ops.
+ */
+export async function declineOffer(token: string): Promise<DeclineResult> {
+  const [entry] = await db
+    .select()
+    .from(s.waitlistEntries)
+    .where(eq(s.waitlistEntries.offerToken, token));
+  if (!entry) return { ok: false, error: "not_found" };
+  if (entry.status === "declined") return { ok: true };
+  if (entry.status !== "offered") return { ok: false, error: "not_offered" };
+
+  const slot = {
+    staffId: entry.offerStaffId!,
+    serviceId: entry.serviceId,
+    startMs: entry.offerSlotStartAt!.getTime(),
+    endMs: entry.offerSlotEndAt!.getTime(),
+  };
+
+  return db.transaction(async (tx) => {
+    // Compare-and-set on status: of any number of concurrent declines (or a
+    // decline racing an accept or the deadline) exactly one gets a row back.
+    const [won] = await tx
+      .update(s.waitlistEntries)
+      .set({ status: "declined", offerHoldToken: null, offerExpiresAt: null })
+      .where(and(eq(s.waitlistEntries.id, entry.id), eq(s.waitlistEntries.status, "offered")))
+      .returning({ id: s.waitlistEntries.id });
+    if (!won) return { ok: false, error: "not_offered" } as const;
+
+    await tx.insert(s.auditLog).values({
+      businessId: entry.businessId,
+      action: "waitlist.declined",
+      entity: "waitlist_entry",
+      entityId: entry.id,
+      meta: { staffId: slot.staffId, startMs: slot.startMs },
+    });
+
+    await cancelByDedupeKey(tx, `waitlist.expire:${entry.id}:${slot.startMs}`);
+
+    // Same hand-off as an expired offer, and the same key, so the two can
+    // never both announce the slot.
+    await enqueue(tx, {
+      businessId: entry.businessId,
+      topic: "waitlist.slot_freed",
+      payload: slot,
+      dedupeKey: `waitlist.refree:${entry.id}:${slot.startMs}`,
+    });
+
+    // Released before commit: once the outbox row is visible a worker may try
+    // to re-hold the slot for the next client straight away.
+    await releaseHold(slot.staffId, slot.startMs);
+    return { ok: true } as const;
+  });
+}
