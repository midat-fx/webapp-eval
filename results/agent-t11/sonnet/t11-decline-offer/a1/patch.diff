+export type DeclineResult = { ok: true } | { ok: false; error: "not_found" | "not_active" };
+
+/**
+ * The client says they cannot come. Only an outstanding offer can be declined;
+ * the conditional update is what makes a double tap, two tabs or two servers
+ * decline exactly once and hand the slot on exactly once.
+ */
+export async function declineOffer(token: string): Promise<DeclineResult> {
+  const [entry] = await db
+    .select()
+    .from(s.waitlistEntries)
+    .where(eq(s.waitlistEntries.offerToken, token));
+  if (!entry) return { ok: false, error: "not_found" };
+  if (entry.status !== "offered") return { ok: false, error: "not_active" };
+
+  const slot = {
+    staffId: entry.offerStaffId!,
+    serviceId: entry.serviceId,
+    startMs: entry.offerSlotStartAt!.getTime(),
+    endMs: entry.offerSlotEndAt!.getTime(),
+  };
+
+  const won = await db.transaction(async (tx) => {
+    const [updated] = await tx
+      .update(s.waitlistEntries)
+      .set({ status: "declined", offerToken: null, offerExpiresAt: null })
+      .where(
+        and(
+          eq(s.waitlistEntries.id, entry.id),
+          eq(s.waitlistEntries.status, "offered"),
+          eq(s.waitlistEntries.offerToken, token),
+        ),
+      )
+      .returning({ id: s.waitlistEntries.id });
+    if (!updated) return false;
+
+    await tx.insert(s.auditLog).values({
+      businessId: entry.businessId,
+      action: "waitlist.declined",
+      entity: "waitlist_entry",
+      entityId: entry.id,
+      meta: { staffId: slot.staffId, startMs: slot.startMs },
+    });
+
+    await cancelByDedupeKey(tx, `waitlist.expire:${entry.id}:${slot.startMs}`);
+
+    // Same key as an expiry, so a deadline racing the decline cannot announce
+    // the slot twice.
+    await enqueue(tx, {
+      businessId: entry.businessId,
+      topic: "waitlist.slot_freed",
+      payload: slot,
+      dedupeKey: `waitlist.refree:${entry.id}:${slot.startMs}`,
+    });
+
+    // Released before commit: the slot_freed message only becomes visible to a
+    // worker once we commit, so by then the hold is already gone and the next
+    // offer can take it.
+    await releaseHold(slot.staffId, slot.startMs, entry.offerHoldToken);
+    return true;
+  });
+
+  return won ? { ok: true } : { ok: false, error: "not_active" };
 }
 
