+
+export type DeclineResult = { ok: true } | { ok: false; error: "not_found" };
+
+/**
+ * The client turns the offer down. The status flip is a single conditional
+ * UPDATE, so of any number of concurrent declines (or a decline racing an
+ * accept) exactly one wins; only the winner frees the slot.
+ */
+export async function declineOffer(token: string): Promise<DeclineResult> {
+  if (!token) return { ok: false, error: "not_found" };
+
+  const declined = await db.transaction(async (tx) => {
+    const [entry] = await tx
+      .update(s.waitlistEntries)
+      .set({
+        status: "declined",
+        offerToken: null,
+        offerExpiresAt: null,
+        offerHoldToken: null,
+      })
+      .where(and(eq(s.waitlistEntries.offerToken, token), eq(s.waitlistEntries.status, "offered")))
+      .returning();
+    if (!entry) return null;
+
+    const slot = {
+      staffId: entry.offerStaffId!,
+      serviceId: entry.serviceId,
+      startMs: entry.offerSlotStartAt!.getTime(),
+      endMs: entry.offerSlotEndAt!.getTime(),
+    };
+
+    await tx.insert(s.auditLog).values({
+      businessId: entry.businessId,
+      action: "waitlist.declined",
+      entity: "waitlist_entry",
+      entityId: entry.id,
+      meta: { staffId: slot.staffId, startMs: slot.startMs },
+    });
+
+    await cancelByDedupeKey(tx, `waitlist.expire:${entry.id}:${slot.startMs}`);
+
+    await enqueue(tx, {
+      businessId: entry.businessId,
+      topic: "waitlist.slot_freed",
+      payload: slot,
+      dedupeKey: `waitlist.refree:${entry.id}:${slot.startMs}`,
+    });
+
+    return { slot, holdToken: entry.offerHoldToken };
+  });
+
+  if (!declined) return { ok: false, error: "not_found" };
+  await releaseHold(declined.slot.staffId, declined.slot.startMs, declined.holdToken ?? undefined);
+  return { ok: true };
 }
 
