+async function releaseHold(staffId: string, startMs: number, onlyToken?: string): Promise<void> {
+  const key = `hold:${staffId}:${startMs}`;
+  if (onlyToken) {
+    // Past the deadline the hold may already belong to someone else.
+    const raw = await redis().get(key);
+    if (!raw || (JSON.parse(raw) as { token: string }).token !== onlyToken) return;
+  }
+  await redis().del(key);
