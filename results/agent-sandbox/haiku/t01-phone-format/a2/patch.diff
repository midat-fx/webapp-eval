diff --git a/src/lib/phone.test.ts b/src/lib/phone.test.ts
new file mode 100644
index 0000000..3fd3233
--- /dev/null
+++ b/src/lib/phone.test.ts
@@ -0,0 +1,22 @@
+import { describe, expect, it } from "vitest";
+import { phoneSchema } from "./phone";
+
+describe("phoneSchema", () => {
+  it.each([
+    ["+77015551234", "+77015551234"],
+    ["+7 701 555 12 34", "+77015551234"],
+    ["+7 (701) 555-12-34", "+77015551234"],
+    ["+7-701-555-12-34", "+77015551234"],
+    ["+7.701.555.12.34", "+77015551234"],
+    [" +7 701 555 12 34 ", "+77015551234"],
+  ])("normalizes %j to %j", (input, expected) => {
+    expect(phoneSchema.parse(input)).toBe(expected);
+  });
+
+  it.each(["call me", "+7 701", "+7 701 555 12 3x", "", "()--", "+7+701555123"])(
+    "rejects %j",
+    (input) => {
+      expect(phoneSchema.safeParse(input).success).toBe(false);
+    },
+  );
+});
diff --git a/src/lib/phone.ts b/src/lib/phone.ts
new file mode 100644
index 0000000..06318ec
--- /dev/null
+++ b/src/lib/phone.ts
@@ -0,0 +1,6 @@
+import { z } from "zod";
+
+export const phoneSchema = z
+  .string()
+  .transform((raw) => raw.replace(/[\s().-]/g, ""))
+  .pipe(z.string().regex(/^\+?\d{10,15}$/));
