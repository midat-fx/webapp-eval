+// One shared Redis subscriber per process fans messages out to the open
+// streams; a stream unregisters itself when the browser goes away, and the
+// channel is dropped when its last listener leaves.
+type Listener = (message: string) => void;
+const listeners = new Map<string, Set<Listener>>();
+let wired = false;
+
+function listen(channel: string, fn: Listener): () => void {
+  const sub = redisSub();
+  if (!wired) {
+    sub.on("message", (ch, message) => listeners.get(ch)?.forEach((l) => l(message)));
+    wired = true;
+  }
+  let set = listeners.get(channel);
+  if (!set) {
+    set = new Set();
+    listeners.set(channel, set);
+    void sub.subscribe(channel);
+  }
+  set.add(fn);
+  return () => {
+    set.delete(fn);
+    if (set.size === 0) {
+      listeners.delete(channel);
+      void sub.unsubscribe(channel);
+    }
+  };
+}
