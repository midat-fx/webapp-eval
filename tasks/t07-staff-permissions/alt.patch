+/**
+ * Pages only the owner may open. For anyone else the page doesn't exist —
+ * no hint that there is something behind the URL.
+ */
+export async function ownerPage(): Promise<Session> {
+  const session = await requireSession();
+  if (session.role !== "owner") notFound();
+  return session;
+}
+
+/** Wraps a server action so that it runs for the owner and silently does nothing for staff. */
+export function ownerAction(fn: (session: Session, formData: FormData) => Promise<void>) {
+  return async (formData: FormData): Promise<void> => {
+    const session = await requireSession();
+    if (session.role !== "owner") return;
+    await fn(session, formData);
+  };
+}
