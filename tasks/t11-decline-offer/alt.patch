+// Deletes a hold only if it is still the one we placed: a newer hold on the
+// same time belongs to someone else.
+const RELEASE_OWN_HOLD = `
+local v = redis.call('GET', KEYS[1])
+if v and cjson.decode(v).token == ARGV[1] then return redis.call('DEL', KEYS[1]) end
+return 0`;
+
+/**
+ * "No thanks" on an offer: the client leaves the queue for that day and the
+ * time is offered to the next person at once.
+ */
+export async function declineOffer(token: string): Promise<boolean> {
+  const declined = await db.transaction(async (tx) => {
+    const { rows } = await tx.execute<{ id: string }>(
+      sql`SELECT id FROM waitlist_entries WHERE offer_token = ${token} AND status = 'offered' FOR UPDATE`,
+    );
+    if (rows.length === 0) return null;
+    const [entry] = await tx
+      .update(s.waitlistEntries)
+      .set({ status: "cancelled", offerExpiresAt: null })
+      .where(eq(s.waitlistEntries.id, rows[0].id))
+      .returning();
+    if (entry.offerHoldToken) {
+      await redis().eval(
+        RELEASE_OWN_HOLD,
+        1,
+        `hold:${entry.offerStaffId}:${entry.offerSlotStartAt!.getTime()}`,
+        entry.offerHoldToken,
+      );
+    }
+    return entry;
+  });
+  if (!declined) return false;
+
+  await offerFreedSlot(declined.businessId, {
+    staffId: declined.offerStaffId!,
+    serviceId: declined.serviceId,
+    startMs: declined.offerSlotStartAt!.getTime(),
+    endMs: declined.offerSlotEndAt!.getTime(),
+  });
+  return true;
+}
+
 async function releaseHold(staffId: string, startMs: number): Promise<void> {
   await redis().del(`hold:${staffId}:${startMs}`);
 }
