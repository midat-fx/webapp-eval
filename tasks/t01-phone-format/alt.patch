@@ -0,0 +1,5 @@
+/** Digits with an optional leading +, or null if it isn't a phone number. */
+export function normalizePhone(raw: string): string | null {
+  const compact = raw.trim().replace(/[ ().-]+/g, "");
+  return /^\+?[0-9]{10,15}$/.test(compact) ? compact : null;
+}
