@@ -0,0 +1,15 @@
+"use client";
+import { useFormStatus } from "react-dom";
+
+/** Disables itself while the status change is in flight: no double clicks. */
+export function StatusButton({ label }: { label: string }) {
+  const { pending } = useFormStatus();
+  return (
+    <button
+      disabled={pending}
+      className="rounded border border-zinc-300 bg-white px-2 py-0.5 text-xs hover:bg-zinc-50 disabled:opacity-50"
+    >
+      {label}
+    </button>
+  );
+}
